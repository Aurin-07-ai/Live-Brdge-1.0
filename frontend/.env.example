# Flask backend base URL (no trailing /api).
# Local:      http://localhost:5000
# Production: https://your-render-service.onrender.com
VITE_API_URL=http://localhost:5000

# auto = use backend when reachable, otherwise demo data (good for local dev)
# live = always use backend | demo = always use built-in demo
# Use "live" in production: a sleeping Render free service can make the 2.5s
# health probe in "auto" mode fall back to demo data without showing an error.
VITE_API_MODE=auto
