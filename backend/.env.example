# Copy this file to .env for local development. Never commit .env.
# On Render, set these as service environment variables instead.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated allowed browser origins (no trailing slash).
# Local: http://localhost:3000
# Production: https://your-vercel-project.vercel.app
# If you use several (Vercel preview URLs, custom domain), separate them with commas.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: Neon PostgreSQL connection string. When set, the backend uses Postgres
# instead of the local SQLite file. Never commit the real value.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/livebridge?sslmode=require

# Optional overrides (SQLite fallback only)
# DATABASE_PATH=C:\path\to\healthbridge.db
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# PORT=5000
# FLASK_DEBUG=0
